# ===== REQUIRED =====

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
GITHUB_TOKEN=your_github_token_here

# ===== MULTI-AGENT LLM (optional but recommended) =====

# DeepSeek R1 API Key (for advanced reasoning)
# Get from: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (for GPT-4)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Multi-Agent Strategy
# Options: ensemble, specialized, fallback, single
# - ensemble: Query all LLMs, pick best result (most accurate but expensive)
# - specialized: Use each LLM for what it's best at (recommended)
# - fallback: Try cheap LLMs first, fallback to expensive (cost-effective)
# - single: Use only Gemini (cheapest)
LLM_STRATEGY=specialized

# ===== OPTIONAL (for enhanced features) =====

# Jira Configuration
# Get API token from: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your_jira_api_token

# Slack Configuration
# Create bot at: https://api.slack.com/apps
# Required scopes: chat:write, chat:write.public
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_CHANNEL=#project-updates

# ===== AGENT CONFIGURATION =====

# Default repository and project (optional)
# GITHUB_REPO=owner/repo
# JIRA_PROJECT=PROJ
# MAX_ISSUES=5

